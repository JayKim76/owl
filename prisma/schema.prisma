generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id          Int        @id @default(autoincrement())
  name        String?
  phone       String     @unique
  tenantPhone String?
  victimPhone String?
  address     String?
  createdAt   DateTime   @default(now())
  estimates   Estimate[]
  tasks       Task[]
}

model Partner {
  id            Int          @id @default(autoincrement())
  companyName   String
  contactName   String?
  phone         String       @unique
  specialty     String?
  email         String?
  region        String?
  partnerCode   String?      @unique
  status        String       @default("pending")
  rating        Int          @default(0)
  completedJobs Int          @default(0)
  memo          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  tasks         Task[]
  generalUser   GeneralUser?
  createdById   Int?
  createdBy     GeneralUser? @relation("PartnerCreator", fields: [createdById], references: [id])
}

model Estimate {
  id              Int       @id @default(autoincrement())
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerId      Int?
  customerPhone   String?
  
  // 1. 기본 정보
  parking         Boolean   @default(false)
  elevator        Boolean   @default(false)
  heatingTarget   String?
  floorLevel      String?
  leakLocation    String?
  leakAmount      String?
  urgency         String?
  boilerBrand     String?
  boilerError     String?
  boilerPipeSize  String?
  waterBill       String?
  managerCheck    Boolean   @default(false)
  downstairsCheck Boolean   @default(false)
  
  // 2. 피해 증상
  damageAreas      Json?    // ["화장실", "거실"]
  customDamageArea String?
  timing           String?
  
  // 3. 탐지 수칙
  detectChecks     Json?
  customDetectItem String?
  
  // 4. 필요 작업 내용 및 비용
  detectionDetails String?
  detectionFee     Int?
  requiredWorks    Json?
  estimatedMinPrice Int?
  estimatedMaxPrice Int?
  
  createdAt       DateTime  @default(now())
  task            Task?
}

model Task {
  id           Int       @id @default(autoincrement())
  estimate     Estimate? @relation(fields: [estimateId], references: [id])
  estimateId   Int?      @unique
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerId   Int?
  partner      Partner?  @relation(fields: [partnerId], references: [id])
  partnerId    Int?
  
  title        String
  status       String    @default("대기중")
  scheduledDate DateTime?
  description  String?
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  Int?
  createdBy    GeneralUser? @relation("TaskCreator", fields: [createdById], references: [id])
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @default("admin")
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Company {
  id           Int           @id @default(autoincrement())
  name         String
  ownerName    String
  phone        String        @unique
  email        String?       @unique
  passwordHash String
  isActive     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscription Subscription?
}

model Subscription {
  id        Int      @id @default(autoincrement())
  companyId Int      @unique
  company   Company  @relation(fields: [companyId], references: [id])
  plan      String   @default("trial")
  status    String   @default("pending")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EstimateTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  fileUrl      String?
  fieldMapping Json?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CostSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Int
  label     String
  updatedAt DateTime @updatedAt
}

model GeneralUser {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String?  @unique
  passwordHash String
  memo         String?
  isActive     Boolean  @default(true)
  lastLogin    DateTime?
  partnerId    Int?     @unique
  partner      Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdPartners Partner[] @relation("PartnerCreator")
  createdTasks    Task[]    @relation("TaskCreator")
}
